# Copia este archivo como .env.local y completa los valores de tu proyecto.
# Project Settings > API en el panel de Supabase.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# true carga los datos de demostración la primera vez que las tablas estén vacías.
VITE_SUPABASE_SEED_DEMO=false

# URL pública donde se despliega la interfaz web para acceso móvil desde cualquier lugar.
# Si se deja vacía, el QR usará la red Wi-Fi local de la computadora.
VITE_MOBILE_APP_URL=
